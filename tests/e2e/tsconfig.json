{
  // The root `tsconfig.json` deliberately excludes `tests` and
  // `playwright.config.ts` so that `next build` never type-checks the suite —
  // otherwise a production install without devDependencies would fail on the
  // missing `@playwright/test` types. The side effect was that the editor put
  // these files in an *inferred* project with no `@types` at all, so every
  // `process.env` lookup reported "Cannot find name 'process'". This project
  // puts them back under real type-checking without touching the build.
  //
  // Extends the ROOT config, not the sibling `../tsconfig.json`: that one is
  // the Vitest project, and mixing Playwright's `test` / `expect` globals with
  // Vitest's in a single program is exactly the confusion the split avoids.
  // `../tsconfig.json` excludes this directory for the same reason.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["**/*.ts", "../../playwright.config.ts"],
  "exclude": []
}
