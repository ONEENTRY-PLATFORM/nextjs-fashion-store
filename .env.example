# ── OneEntry / app ───────────────────────────────────────────────────────────
# The SDK is isomorphic and the auth flow runs in the browser (OneEntry binds
# the refresh token to the device fingerprint of the request that issued it,
# so a server-minted token could never be refreshed from the browser). Both
# values therefore have to reach the client — hence `NEXT_PUBLIC_`.
# Project URL + App Token: OE admin → Settings → App Token.
NEXT_PUBLIC_ONEENTRY_URL=
NEXT_PUBLIC_ONEENTRY_TOKEN=

# Locales are NOT configured here. The routed languages come from the project
# itself (OE → Settings → Localization), snapshotted into
# `src/lib/oneentry/locales.generated.ts` by `npm run gen:locales`, which runs
# automatically before `dev` and `build` when the generator is present (it lives
# outside the repo, so a clone builds from the committed snapshot instead).
# The default locale — the one served on un-prefixed URLs — is the
# `DEFAULT_LOCALE` constant in `src/lib/oneentry/locale.ts`.

# Google OAuth 2.0 Client ID (Google Cloud Console → Credentials). Must list
# `${origin}/auth/callback/google` under "Authorised redirect URIs". The
# client secret lives in OneEntry, never here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_VERCEL_URL=

# ── OneEntry admin panel (one-off content fill scripts only) ─────────────────
# Used by the maintenance scripts under `.claude/temp/` to write content: the
# public SDK is read-only, so they log into the admin UI with Playwright and
# replay the panel's own REST calls. Never needed by the app at runtime —
# keep out of the client.
OE_ADMIN_LOGIN=
OE_ADMIN_PASSWORD=

# ── Playwright E2E shopper ──────────────────────────────────────────────────
# The authenticated specs sign in as a permanent test user. Unset, the suite
# falls back to `test@test.com` / `111` (see `tests/e2e/helpers.ts`), which any
# real tenant rejects — the login modal never closes and every authenticated
# spec fails inside `login()`, which reads as a code failure but is not one.
# Reuse one long-lived account; OneEntry has no self-serve user deletion, so
# per-run sign-ups accumulate in the tenant.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
