# ── OneEntry / app ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=
BASE_URL=
ONEENTRY_URL=
ONEENTRY_TOKEN=
GOOGLE_CLIENT_ID=

# ── Cache ────────────────────────────────────────────────────────────────────
# =1 collapses every OE data-cache window to 1 second, so content edits in the
# OE admin show up immediately. Dev / staging only — leave empty in production.
# Per-page TTL defaults live in src/lib/isr.ts.
ISR_DISABLED=

# ── Profiling (off by default) ───────────────────────────────────────────────
# =1 times every wrapped OE loader: logs `[OE-timing] <name> ok <ms>ms` and
# records into the ring buffer served by /api/perf-dump. See
# src/lib/oneentry/profiling.ts. Requires a restart / redeploy to take effect.
OE_PROFILE=

# Only log calls slower than N ms (default 0 = log everything). Filtering is
# stdout-only — every call still lands in the buffer.
OE_PROFILE_SLOW_MS=

# Bearer token for GET/DELETE /api/perf-dump. Unset ⇒ the endpoint 401s on
# every request. Generate with: openssl rand -hex 32
PERF_DUMP_TOKEN=
