# ── OneEntry / app ───────────────────────────────────────────────────────────
# The SDK is isomorphic and the auth flow runs in the browser (OneEntry binds
# the refresh token to the device fingerprint of the request that issued it,
# so a server-minted token could never be refreshed from the browser). Both
# values therefore have to reach the client — hence `NEXT_PUBLIC_`.
# Project URL + App Token: OE admin → Settings → App Token.
NEXT_PUBLIC_ONEENTRY_URL=
NEXT_PUBLIC_ONEENTRY_TOKEN=

# Optional OE locale override for every fetcher (default: en_US).
NEXT_PUBLIC_DEFAULT_LOCALE=

# Google OAuth 2.0 Client ID (Google Cloud Console → Credentials). Must list
# `${origin}/auth/callback/google` under "Authorised redirect URIs". The
# client secret lives in OneEntry, never here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

NEXT_PUBLIC_VERCEL_URL=

# ── OneEntry admin panel (one-off content fill scripts only) ─────────────────
# Used by the maintenance scripts under `.claude/temp/` to write content: the
# public SDK is read-only, so they log into the admin UI with Playwright and
# replay the panel's own REST calls. Never needed by the app at runtime —
# keep out of the client.
OE_ADMIN_LOGIN=
OE_ADMIN_PASSWORD=
