{
  "name": "e-commerce-website",
  "private": true,
  "version": "0.1.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src app tests",
    "lint:fix": "eslint src app tests --fix",
    "format": "prettier --write \"{src,app,tests,.storybook}/**/*.{ts,tsx,js,mjs,css,json,md}\"",
    "format:check": "prettier --check \"{src,app,tests,.storybook}/**/*.{ts,tsx,js,mjs,css,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:tests && npm run typecheck:e2e",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@reduxjs/toolkit": "^2.12.0",
    "lucide-react": "^1.29.0",
    "next": "^16.3.0",
    "oneentry": "^1.0.158",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-onboarding": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/nextjs-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.5.7",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "jsdom": "^30.0.1",
    "mermaid": "^11.16.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "enhanced-resolve": "5.21.6"
  }
}
